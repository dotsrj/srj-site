---
import "../assets/main.css";

// TEMP demo data (we'll move this to files later)
const releases = [
  { title: "Protocol.001", href: "https://example.com/protocol001", download: "#", vinyl: "#", cd: "#", cassette: "#" },
  { title: "Protocol.002", href: "https://example.com/protocol002", download: "#", vinyl: "#", cd: "#", cassette: "#" },
  { title: "Signal EP",    href: "https://example.com/signalep",   download: "#", vinyl: "#", cd: "#", cassette: "#" },
];
const artworks = [
  { title: "Glyph A", buy: "#", preview: "#" },
  { title: "Glyph B", buy: "#", preview: "#" },
  { title: "Glyph C", buy: "#", preview: "#" },
];
const log = [
  { date: "2025-11-06", text: "wired hub chassis; CRT and carousels." },
  { date: "2025-11-05", text: "INFINITRON UX rwxr-xr-x; calibrated.", img: "/public/favicon.svg" },
  { date: "2025-11-04", text: "astro scaffold + gitops live." },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>.srj — hub</title>

    <!-- Google Fonts (Teko) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Teko:wght@300&display=swap" rel="stylesheet">

    <!-- CSP: allow YouTube + SoundCloud iframes, Google Fonts -->
    <meta http-equiv="Content-Security-Policy" content="
  default-src 'self';
  img-src 'self' data:;
  style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
  font-src  'self' https://fonts.gstatic.com;
  script-src 'self';
  connect-src 'self';
  frame-src https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com https://w.soundcloud.com https://soundcloud.com;
  frame-ancestors 'none';
  base-uri 'self';
  form-action 'self'
">
  </head>
  <body>
    <div class="hub">
      <div class="hub-grid">

<!-- 1) VIDEO (YouTube, privacy mode) -->
<section class="panel screen area-video">
  <!-- Replace VIDEO_ID with your actual video id -->
  <iframe
    class="embed"
    src="https://www.youtube-nocookie.com/embed/VIDEO_ID?rel=0&modestbranding=1&color=white"
    title="YouTube player"
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    referrerpolicy="no-referrer"
    allowfullscreen>
  </iframe>
</section>


        <!-- 2) ENTRY LOG (right, scrollable) -->
        <aside class="panel screen area-log">
          <div style="margin-bottom:8px;">entry log</div>
          <div class="log-list">
            {log.map(item => (
              <div class="log-entry">
                <div><small>{item.date}</small></div>
                <div>{item.text}</div>
                {item.img && <img src={item.img} alt="log media" />}
              </div>
            ))}
          </div>
        </aside>

        <!-- 3) RELEASES (left middle) -->
        <section class="panel screen area-release">
          <div style="margin-bottom:8px;">releases</div>
          <div class="carousel">
            {releases.map(r => (
              <div class="card">
                <div class="folder">{r.title}</div>
                <a href={r.href}>page</a> · <a href={r.download}>free dl</a><br/>
                <a href={r.vinyl}>vinyl</a> · <a href={r.cd}>cd</a> · <a href={r.cassette}>cassette</a>
              </div>
            ))}
          </div>
        </section>

        <!-- 4) ARTWORK (right middle) -->
        <section class="panel screen area-artwork">
          <div style="margin-bottom:8px;">artwork</div>
          <div class="carousel">
            {artworks.map(a => (
              <div class="card">
                <div class="folder">{a.title}</div>
                <a href={a.preview}>preview</a> · <a href={a.buy}>buy print</a>
              </div>
            ))}
          </div>
        </section>

        <!-- 5) AUDIO (bottom) -->
        <section class="panel screen area-audio">
          <iframe
            class="embed"
            src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%253Aplaylists%253A2078346597&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true"></iframe><div style="font-size: 10px; color: #cccccc;line-break: anywhere;word-break: normal;overflow: hidden;white-space: nowrap;text-overflow: ellipsis; font-family: Interstate,Lucida Grande,Lucida Sans Unicode,Lucida Sans,Garuda,Verdana,Tahoma,sans-serif;font-weight: 100;"><a href="https://soundcloud.com/dotsrj" title=".srj" target="_blank" style="color: #cccccc; text-decoration: none;">.srj</a> · <a href="https://soundcloud.com/dotsrj/sets/opus-no-12" title="Opus No. 12" target="_blank" style="color: #cccccc; text-decoration: none;">Opus No. 12</a></div>ayer/?url=https%3A//api.soundcloud.com/tracks/123456789&auto_play=false&show_artwork=true">
          </iframe>
        </section>

      </div>
    </div>
  </body>
</html>
