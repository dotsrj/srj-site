---
import "../assets/main.css";
import { getCollection } from "astro:content";

// BASE ensures GitHub Pages subpath works, e.g. /srj-site/
const BASE = import.meta.env.BASE_URL;

const log = (await getCollection("log")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const releases = await getCollection("releases");
const artworks = await getCollection("art");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>.srj — hub</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Teko:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400&display=swap" rel="stylesheet">


    <!-- Strict CSP (no inline JS; we use /js/main.js) -->
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      img-src 'self' data:;
      style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
      font-src  'self' https://fonts.gstatic.com;
      script-src 'self';
      connect-src 'self' https://formspree.io;
      frame-src https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com https://w.soundcloud.com https://soundcloud.com;
      frame-ancestors 'none';
      base-uri 'self';
      form-action 'self' https://formspree.io
    ">
  </head>
<body class="tiles-compact">
  <div class="hub-shell">
    <main class="hub-grid">

  <!-- STATUS / NAMEPLATE BAR -->
<section class="panel shell-header area-status">
  <div class="status-label">/user/.SRJ> | ig/yt: @dotsrj | dotsrj11001010(at)gmail.com </div>
</section>

<!-- VIDEO DISPLAY -->
<section class="panel screen area-video">
  <div class="wrap">
    <iframe
      class="embed"
      src="https://www.youtube.com/embed/Hrafn9Pl29I?si=HhlpcDUyh5hdNBab"
      title="YouTube player"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen>
    </iframe>
  </div>
</section>



      <!-- LEFT / BOTTOM: tabbed media -->
      <section class="panel screen area-media" aria-label="media">
        <div class="tabs">
<button class="tab is-active" data-tab="releases" type="button" aria-selected="true">releases</button>
<button class="tab" data-tab="art" type="button" aria-selected="false">art</button>

        </div>

        <div class="tabpanes">
          <!-- Releases: directory tree -->
          <div class="pane is-active" id="pane-releases">
            <ul class="tree">
              {releases.map((r) => (
                <li>
                  <button
                    type="button"
                    class="tree-item"
                    data-title={r.data.title}
                    data-page={r.data.page || ""}
                    data-download={r.data.download || ""}
                    data-vinyl={r.data.vinyl || ""}
                    data-cd={r.data.cd || ""}
                    data-cassette={r.data.cassette || ""}
                  >
                    <span class="tree-glyph">▸</span> {r.data.title}
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <!-- Art: carousel -->
          <div class="pane" id="pane-art">
  <div class="gallery">
    <!-- Main viewer -->
    <div class="gallery__main">
      {/*
        Start with the first artwork. Astro renders the full BASE url here.
        We also stash index/title/links as data-* so JS can update the meta.
      */}
      <img
        id="art-main"
        class="gallery__main-img"
        src={`${BASE}${artworks[0].data.image}`}
        alt={`${artworks[0].data.title} image`}
        data-index="0"
      />
      <div class="gallery__meta" id="art-meta">
        <strong class="gallery__title">{artworks[0].data.title}</strong>
        <div class="gallery__links">
          {artworks[0].data.preview && <a href={artworks[0].data.preview} target="_blank" rel="noopener">preview</a>}
          {artworks[0].data.preview && artworks[0].data.buy && ' · '}
          {artworks[0].data.buy && <a href={artworks[0].data.buy} target="_blank" rel="noopener">buy print</a>}
        </div>
      </div>
    </div>

    <!-- Thumbnail strip -->
    <div class="gallery__thumbs" role="listbox" aria-label="art thumbnails">
      {artworks.map((a, i) => (
        <button
          type="button"
          class={`thumb ${i===0 ? 'is-active' : ''}`}
          data-index={i}
          data-src={`${BASE}${a.data.image}`}
          data-title={a.data.title}
          data-preview={a.data.preview || ''}
          data-buy={a.data.buy || ''}
          aria-selected={i===0}
          title={a.data.title}
        >
          <img src={`${BASE}${a.data.image}`} alt={`${a.data.title} thumbnail`} />
        </button>
      ))}
    </div>
  </div>
</div>
      </section>

      <!-- RIGHT: inbox → audio → log -->
      <aside class="right-stack">
        <!-- Inbox -->
        <section class="panel inbox" aria-label="visitor input">
          <form id="inbox-form" class="inbox" method="POST">
            <div class="inbox-row">
              <input
                id="inbox-input"
                type="text"
                name="message"
                maxlength="144"
                placeholder=""
                aria-label="short message input"
                autocomplete="off"
                autofocus
                required
              />
            </div>
            <input type="hidden" name="source" value="srj-site" />
          </form>
          <div id="inbox-status" style="margin-top:6px; font-size:12px; opacity:.8;"></div>
        </section>

        <!-- SoundCloud -->
        <section class="panel screen area-audio">
          <iframe
            class="embed embed--sc"
            title="SoundCloud player"
            loading="lazy"
            allow="autoplay"
            referrerpolicy="no-referrer"
            src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%253Aplaylists%253A2078346597">
          </iframe>
        </section>

        <!-- Log -->
        <section class="panel screen area-log">
  <div style="margin-bottom:8px;">entry log</div>
  <div class="log-list">
    {log.map((entry) => (
      <div class="log-entry" data-text={entry.data.text}>
        <div><span class="badge">{entry.data.date}</span></div>
        <div class="typed"></div>
        {entry.data.image && <img src={`${BASE}${entry.data.image}`} alt="log media" />}
      </div>
    ))}
  </div>
</section>
      </aside>
    </main>

    <!-- Releases modal -->
    <div id="release-modal" class="modal" hidden>
      <div class="modal__window">
        <div class="modal__title" id="release-modal-title"></div>
        <div class="modal__links" id="release-modal-links"></div>
        <div class="modal__actions">
          <button type="button" class="btn" id="release-modal-close">close</button>
        </div>
      </div>
      <div class="modal__backdrop"></div>
    </div>

  
    

 <script type="module" src={`${BASE}js/main.js`}></script>
</div>
  </body>
</html>
