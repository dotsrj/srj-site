---
import "../assets/main.css";
import { getCollection } from "astro:content";

const BASE = import.meta.env.BASE_URL;

const log = (await getCollection("log")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const artworks = await getCollection("art");

const releases = (await getCollection("releases")).sort((a, b) => {
  const ao = a.data.order ?? 9999;
  const bo = b.data.order ?? 9999;
  if (ao !== bo) return ao - bo;
  return a.data.title.localeCompare(b.data.title, undefined, { numeric: true });
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>.srj — hub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Teko:wght@300&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400&display=swap" rel="stylesheet">

    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      img-src 'self' data:;
      style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
      font-src  'self' https://fonts.gstatic.com;
      script-src 'self';
      connect-src 'self' https://formspree.io;
      frame-src https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com https://w.soundcloud.com https://soundcloud.com;
      frame-ancestors 'none';
      base-uri 'self';
      form-action 'self' https://formspree.io;
    ">
  </head>

  <body class="tiles-compact">
    <div class="hub-shell">
      <main class="hub-grid">

        <!-- STATUS -->
        <section class="panel shell-header area-status">
          <div class="status-label">/user/.SRJ> | ig/yt: @dotsrj | dotsrj11001010(at)gmail.com</div>
        </section>

        <!-- VIDEO -->
        <section class="panel screen area-video">
          <div class="wrap">
            <iframe
              class="embed"
              src="https://www.youtube.com/embed/Hrafn9Pl29I?si=HhlpcDUyh5hdNBab"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen>
            </iframe>
          </div>
        </section>

        <!-- MEDIA PANEL -->
        <section class="panel screen area-media" aria-label="media">
          <div class="tabs">
            <button class="tab is-active" data-tab="releases" type="button">releases</button>
            <button class="tab" data-tab="art" type="button">art</button>
          </div>

          <div class="tabpanes">

            <!-- RELEASES -->
            <div class="pane is-active" id="pane-releases">
              <ul class="tree">
                {releases.map((r) => {
                  const tracks = Array.isArray(r.data.tracks) ? r.data.tracks : [];
                  const firstTrack = tracks[0] ?? null;
                  const firstFilename = firstTrack ? firstTrack.split("/").pop() : "";
                  const firstTitle = firstFilename
                    ? `${r.data.title} — ${firstFilename}`
                    : r.data.title;

                  return (
                    <li class="tree-node">
                      <button type="button" class="tree-item tree-toggle" aria-expanded="false">
                        <span class="tree-glyph">▸</span> {r.data.title}
                      </button>

                      <div class="tree-contents" hidden>
                        {r.data.cover && (
                          <div class="tree-cover-wrap" style="margin:8px 0;">
                            <img
                              class={`tree-cover ${firstTrack ? "track-play" : ""}`}
                              src={`${BASE}${r.data.cover}`}
                              alt={`${r.data.title} cover`}
                              data-src={firstTrack ? `${BASE}${firstTrack}` : undefined}
                              data-title={firstTitle}
                              style="max-width:180px;border-radius:8px;border:1px solid rgba(182,255,156,0.35)"
                            />
                          </div>
                        )}

                        {r.data.readme && (
                          <div class="tree-readme" style="margin:4px 0 10px;">
                            <a href={`${BASE}${r.data.readme}`} target="_blank" rel="noopener">README</a>
                          </div>
                        )}

                        {tracks.length > 0 && (
                          <ol class="tree-tracks" style="padding-left:18px; margin: 0;">
                            {tracks.map((t, idx) => {
                              const filename = t.split("/").pop() || "";
                              const safeLabel = filename.replace(/\.mp3$/i, "");
                              const fullSrc = `${BASE}${t}`;
                              const fullTitle = `${r.data.title} — ${filename}`;

                              return (
                                <li class="tree-track" style="margin:6px 0;">
                                  <button
                                    type="button"
                                    class="track-playlink"
                                    data-src={fullSrc}
                                    data-title={fullTitle}
                                  >
                                    {String(idx + 1).padStart(2, "0")}. {safeLabel}
                                  </button>

                                  <span style="opacity:.6"> · </span>
                                  <a href={fullSrc} download>download</a>

                                  <span style="opacity:.6"> · </span>
                                  <button type="button" class="track-copy" data-src={fullSrc}>copy url</button>

                                  <span style="opacity:.6"> · </span>
                                  <button
                                    type="button"
                                    class="track-play"
                                    data-src={fullSrc}
                                    data-title={fullTitle}
                                  >
                                    play
                                  </button>
                                </li>
                              );
                            })}
                          </ol>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>

              <div id="release-inline-player" class="audio-dock" hidden>
                <div id="rip-label">select a track to play</div>
                <audio id="rip-audio" controls preload="none"></audio>
              </div>
            </div>

            <!-- ART -->
            <div class="pane" id="pane-art">
              <div class="gallery">
                <div class="gallery__main">
                  <img
                    id="art-main"
                    class="gallery__main-img"
                    src={`${BASE}${artworks[0].data.image}`}
                    alt={`${artworks[0].data.title} image`}
                    data-index="0"
                  />
                  <div class="gallery__meta" id="art-meta">
                    <strong class="gallery__title">{artworks[0].data.title}</strong>
                    <div class="gallery__links">
                      {artworks[0].data.preview && (
                        <a href={artworks[0].data.preview} target="_blank" rel="noopener">preview</a>
                      )}
                      {artworks[0].data.preview && artworks[0].data.buy && " · "}
                      {artworks[0].data.buy && (
                        <a href={artworks[0].data.buy} target="_blank" rel="noopener">buy print</a>
                      )}
                    </div>
                  </div>
                </div>

                <div class="gallery__thumbs" role="listbox">
                  {artworks.map((a, i) => (
                    <button
                      type="button"
                      class={`thumb ${i === 0 ? "is-active" : ""}`}
                      data-index={i}
                      data-src={`${BASE}${a.data.image}`}
                      data-title={a.data.title}
                      data-preview={a.data.preview || ""}
                      data-buy={a.data.buy || ""}
                      aria-selected={i === 0}
                    >
                      <img src={`${BASE}${a.data.image}`} alt={`${a.data.title} thumbnail`} />
                    </button>
                  ))}
                </div>
              </div>
            </div>

          </div>
        </section>

        <!-- RIGHT COLUMN -->
        <aside class="right-stack">
          <section class="panel inbox">
            <form id="inbox-form" method="POST">
              <div class="inbox-row">
                <input id="inbox-input" name="message" maxlength="144" autocomplete="off" required />
              </div>
              <input type="hidden" name="source" value="srj-site" />
            </form>
            <div id="inbox-status" style="margin-top:6px; font-size:12px; opacity:.8;"></div>
          </section>

          <section class="panel screen area-audio">
            <iframe
              class="embed embed--sc"
              loading="lazy"
              allow="autoplay"
              referrerpolicy="no-referrer"
              src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/playlists/soundcloud%253Aplaylists%253A2078346597">
            </iframe>
          </section>

          <section class="panel screen area-log">
            <div style="margin-bottom:8px;">entry log</div>
            <div class="log-list">
              {log.map((entry) => (
                <div class="log-entry" data-text={entry.data.text}>
                  <div><span class="badge">{entry.data.date}</span></div>
                  <div class="typed"></div>
                  {entry.data.image && <img src={`${BASE}${entry.data.image}`} alt="log media" />}
                </div>
              ))}
            </div>
          </section>
        </aside>

      </main>

      <script type="module" src={`${BASE}js/main.js`}></script>
    </div>
  </body>
</html>
